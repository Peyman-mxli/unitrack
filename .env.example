# UniTrack configuration example — do NOT commit real secrets.
# PowerShell variables can be set using: $env:VARIABLE="value"
UNITRACK_ENV=development
# Campus local clock, including daylight saving rules:
UNITRACK_TIMEZONE=America/Tijuana
FLASK_DEBUG=False
# Use a randomly generated, persistent strong key in production.
SECRET_KEY=
# On first boot of a NEW database ONLY, set a unique 12+ char admin password:
UNITRACK_INITIAL_ADMIN_PASSWORD=
# Configure PostgreSQL for durable production data:
DATABASE_URL=
APP_BASE_URL=http://127.0.0.1:5000
# Account recovery email; use a NEW app password after revoking exposed secrets:
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
# Disabled by default; only for a short admin-only migration period:
UNITRACK_ALLOW_LEGACY_QR=False
